unsigned char port_byte_in(unsigned short port) {
    unsigned char data = 0;
    __asm__(
        "mov %1, %%dx\n\t"
        "in %0, %%dx"
        : "=r"(data)
        : "r"(port)
    );
    return data;
}

void port_byte_out(unsigned short port, unsigned char data) {
    __asm__(
        "mov %1, %%dx\n\t"
        "out %%dx, %0"
        :
        : "r"(data), "r"(port)
    );
}